  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "33.4.11",
    "electron-vite": "^2.3.0",
    "electron-builder": "^25.1.8",
